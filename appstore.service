[Unit]
Description=Proxmox App Store web UI
After=network-online.target
Wants=network-online.target

[Service]
User=appstore
WorkingDirectory=/opt/appstore
Environment=PORT=80 DATA_DIR=/var/lib/appstore
ExecStart=/usr/bin/node /opt/appstore/server.js
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
