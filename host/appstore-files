#!/usr/bin/perl
# appstore-files - file access for the App Store's file browser.
#
# Lives on the Proxmox host as /usr/local/bin/appstore-files. The App Store reaches it over SSH
# with a key that can run nothing else (a forced command in root's authorized_keys).
#
# Request, on stdin: one line of JSON, {"op":..., "vmid":..., "path":...}, followed by the file's
# bytes for a write. Answer: the result on stdout and exit code 0, or "ERR: reason" on stderr.
#
# It only works on running, unprivileged containers. Each request joins the container's user
# namespace and changes root into the container before it touches a file, so it has exactly the
# rights of root inside that container: links cannot lead out of it, and nothing on the host,
# including /proc and /sys settings, can be changed.
use strict;
use warnings;
use JSON::PP;
use Fcntl qw(:mode O_WRONLY O_CREAT O_EXCL);

my $VERSION = 2;
my $MAX_WRITE = 70_000_000;
my $json = JSON::PP->new->utf8;

sub fail { print STDERR "ERR: $_[0]\n"; exit 1; }

# ---------- step 1, as root on the host: find the container and join its user namespace ----------
if (!@ARGV) {
  my ($line, $c) = ('');
  while (sysread(STDIN, $c, 1)) {            # byte by byte: what follows the line belongs to step 2
    last if $c eq "\n";
    $line .= $c;
    fail('Request too long') if length($line) > 20000;
  }
  my $r = eval { $json->decode($line) };
  fail('Bad request') unless ref $r eq 'HASH';
  if (($r->{op} // '') eq 'version') { print $json->encode({ version => $VERSION }); exit 0; }

  my $vmid = $r->{vmid} // '';
  fail('Bad container ID') unless $vmid =~ /^[1-9][0-9]{2,8}$/;
  fail("Container $vmid does not exist on this host") unless -f "/etc/pve/lxc/$vmid.conf";
  my $pid = `/usr/bin/lxc-info -n $vmid -p -H 2>/dev/null` // '';
  chomp $pid;
  fail('NOTRUNNING') unless $pid =~ /^[0-9]+$/ && $pid > 1;
  my $mine = readlink('/proc/self/ns/user');
  my $theirs = readlink("/proc/$pid/ns/user");
  # A privileged container shares the host's user namespace: root in it is root on the host.
  fail('PRIVILEGED') if !defined $mine || !defined $theirs || $mine eq $theirs;

  $ENV{APPSTORE_REQ} = $line;
  exec('/usr/bin/nsenter', '-t', $pid, '-U', '--', $^X, $0, 'inner', $pid) or fail("Cannot run nsenter: $!");
}

# ---------- step 2, as root of the container's user namespace ----------
fail('Bad call') unless $ARGV[0] eq 'inner' && ($ARGV[1] // '') =~ /^[0-9]+$/;
my $r = eval { $json->decode($ENV{APPSTORE_REQ} // '') };
fail('Bad request') unless ref $r eq 'HASH';
# Use the JSON encoder once now: after the change of root, Perl can no longer load anything it needs for it.
my $warm = $json->encode({ a => "b\x{20ac}\n", n => 1, t => JSON::PP::true, l => [] });
binmode(STDIN); binmode(STDOUT);

chroot("/proc/$ARGV[1]/root") or fail("Cannot open the container's files: $!");
chdir('/') or fail("Cannot open the container's files: $!");

# A path from the request, as the bytes the file system wants.
sub path {
  my $p = $_[0];
  fail('Bad path') unless defined $p && !ref $p && $p =~ m{^/} && $p !~ /\0/ && length($p) <= 4096;
  utf8::encode($p);
  return $p;
}
sub parent { my $p = $_[0]; $p =~ s{/+$}{}; $p =~ s{/[^/]*$}{}; return $p eq '' ? '/' : $p; }
# New files and folders get the owner of the folder they are in, like the files around them.
sub own { my @s = stat(parent($_[0])); chown($s[4], $s[5], $_[0]) if @s; }
sub kind { my $m = $_[0]; return S_ISDIR($m) ? 'd' : S_ISLNK($m) ? 'l' : S_ISREG($m) ? 'f' : 'o'; }
sub text { my $t = $_[0]; utf8::decode($t); return $t; }   # names that are not UTF-8 are passed on byte for byte
sub done { print $json->encode({ ok => JSON::PP::true }); exit 0; }
# Removes a file, a link (never what it points to) or a folder with everything in it.
sub remove {
  my $p = $_[0];
  my @s = lstat($p) or fail("Cannot delete $p: $!");
  if (S_ISDIR($s[2])) {
    opendir(my $d, $p) or fail("Cannot delete $p: $!");
    my @names = grep { $_ ne '.' && $_ ne '..' } readdir($d);
    closedir($d);
    remove("$p/$_") for @names;
    rmdir($p) or fail("Cannot delete $p: $!");
  } else {
    unlink($p) or fail("Cannot delete $p: $!");
  }
}

my $op = $r->{op} // '';
my $p = path($r->{path});

if ($op eq 'list') {
  opendir(my $d, $p) or fail("Cannot open this folder: $!");
  my (@out, $n);
  my $base = $p eq '/' ? '' : $p;
  while (defined(my $e = readdir($d))) {
    next if $e eq '.' || $e eq '..';
    last if ++$n > 5000;
    my @s = lstat("$base/$e") or next;
    my %i = (name => text($e), type => kind($s[2]), size => $s[7] + 0, mtime => $s[9] + 0, mode => sprintf('%04o', $s[2] & 07777));
    if ($i{type} eq 'l') {                     # where a link leads, so the browser knows whether it can be opened
      my $l = readlink("$base/$e");
      $i{link} = text($l) if defined $l;
      my @t = stat("$base/$e");
      $i{target} = @t ? kind($t[2]) : 'x';
    }
    push @out, \%i;
  }
  print $json->encode({ entries => \@out, truncated => ($n // 0) > 5000 ? JSON::PP::true : JSON::PP::false });
  exit 0;
}

if ($op eq 'read') {
  my @s = stat($p) or fail("Cannot open this file: $!");
  fail('NOTFILE') unless S_ISREG($s[2]);
  my $max = ($r->{max} // 0) =~ /^[0-9]+$/ ? $r->{max} + 0 : 0;
  fail('TOOLARGE') if $max && $s[7] > $max;
  open(my $fh, '<', $p) or fail("Cannot open this file: $!");
  binmode($fh);
  my $left = $max || 2**40;                   # files in /proc report size 0, so the limit is enforced while reading too
  while ($left > 0) {
    my $n = sysread($fh, my $buf, $left < 65536 ? $left : 65536);
    fail("Cannot read this file: $!") unless defined $n;
    last unless $n;
    print STDOUT $buf or exit 1;
    $left -= $n;
  }
  exit 0;
}

# A piece of a file that keeps growing, such as a log. Answers "start size" on a line of its own, then the bytes
# from `offset` on. Without an offset it gives the end of the file; an offset past the end means the file was
# started over, so it begins again from the top.
if ($op eq 'tail') {
  my @s = stat($p) or fail('NOFILE');
  fail('NOTFILE') unless S_ISREG($s[2]);
  my $size = $s[7];
  my $max = ($r->{max} // '') =~ /^[0-9]+$/ && $r->{max} > 0 && $r->{max} <= 1_000_000 ? $r->{max} + 0 : 65536;
  my $from = $r->{offset};
  my $start = !defined $from || ref $from || $from !~ /^[0-9]+$/ ? ($size > $max ? $size - $max : 0) : $from > $size ? 0 : $from + 0;
  open(my $fh, '<', $p) or fail("Cannot open this file: $!");
  binmode($fh);
  defined sysseek($fh, $start, 0) or fail("Cannot read this file: $!");
  print STDOUT "$start $size\n";
  my $left = $max;
  while ($left > 0) {
    my $n = sysread($fh, my $buf, $left < 65536 ? $left : 65536);
    fail("Cannot read this file: $!") unless defined $n;
    last unless $n;
    print STDOUT $buf or exit 1;
    $left -= $n;
  }
  exit 0;
}

if ($op eq 'write') {
  my $size = $r->{size} // '';
  fail('Bad size') unless $size =~ /^[0-9]+$/ && $size <= $MAX_WRITE;
  my $data = '';
  while (length($data) < $size) {              # take in the whole file before touching the old one
    my $n = sysread(STDIN, my $buf, $size - length($data));
    last unless $n;
    $data .= $buf;
  }
  fail('The file arrived incomplete, nothing was changed') unless length($data) == $size;
  my $fh;
  my $exists = lstat($p) ? 1 : 0;
  if ($r->{create} && !($r->{replace} && $exists)) {     # `replace` writes over a file that is already there
    fail('Something with that name already exists') if $exists;
    sysopen($fh, $p, O_WRONLY | O_CREAT | O_EXCL, 0644) or fail("Cannot create this file: $!");
    own($p);
  } else {
    my @s = stat($p) or fail("Cannot open this file: $!");
    fail('NOTFILE') unless S_ISREG($s[2]);
    open($fh, '>', $p) or fail("Cannot write this file: $!");   # written in place: owner and permissions stay as they are
  }
  binmode($fh);
  print $fh $data or fail("Cannot write this file: $!");
  close($fh) or fail("Cannot write this file: $!");
  done();
}

if ($op eq 'mkdir') {
  fail('Something with that name already exists') if lstat($p);
  mkdir($p, 0755) or fail("Cannot create this folder: $!");
  own($p);
  done();
}

if ($op eq 'delete') {
  fail('The top folder cannot be deleted') if $p =~ m{^/+$};
  $p =~ s{/+$}{};
  remove($p);
  done();
}

if ($op eq 'rename') {
  my $to = path($r->{to});
  fail('Something with that name already exists') if lstat($to);
  rename($p, $to) or fail("Cannot rename: $!");
  done();
}

fail('Unknown request');
